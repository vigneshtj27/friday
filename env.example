# All settings use the FRIDAY_ prefix. Copy to .env and fill in.
# (Named env.example because a permission rule blocks writing .env* files here;
#  rename to .env.example if you prefer.)

# --- Storage -------------------------------------------------------------
# Root for the SQLite DB and (by default) Chrome profiles.
FRIDAY_DATA_DIR=./data
# Chrome profiles: one persistent user_data_dir per (site, account).
# Must live on an encrypted volume (FileVault, LUKS/dm-crypt, gocryptfs...).
# FRIDAY_PROFILES_DIR=/mnt/encrypted/friday-profiles
# require = refuse to open a profile unless the volume is detected (or asserted) encrypted
# warn    = log a warning and continue
FRIDAY_VOLUME_CHECK=require
# Set to true if your volume is encrypted but auto-detection can't tell
# (e.g. gocryptfs inside Docker, external encrypted disk).
FRIDAY_VOLUME_ENCRYPTED_ASSERT=false

# --- Master key ----------------------------------------------------------
# 32 random bytes, base64. Generate with: friday keygen
# If unset, the key is read from the OS keyring (service FRIDAY_KEYRING_SERVICE).
# FRIDAY_MASTER_KEY=
FRIDAY_KEYRING_SERVICE=friday

# --- Browser -------------------------------------------------------------
# playwright | patchright | cdp
# patchright applies stealth patches: only enable after a diagnosis report calls for it.
FRIDAY_DRIVER=playwright
FRIDAY_CHROME_CHANNEL=chrome
# Only used by the cdp driver; auto-detected if unset.
# FRIDAY_CHROME_EXECUTABLE=/usr/bin/google-chrome
# Chrome sandbox. In Docker it needs user namespaces allowed (see docs/decisions.md).
FRIDAY_CHROME_SANDBOX=true
# auto = Xvfb on Linux, native window on macOS
FRIDAY_DISPLAY_BACKEND=auto
FRIDAY_SCREEN_WIDTH=1920
FRIDAY_SCREEN_HEIGHT=1080
FRIDAY_DEFAULT_LOCALE=en-US
# IANA timezone; must match the profile's egress IP. Empty = host timezone.
# FRIDAY_DEFAULT_TIMEZONE=Asia/Kolkata
FRIDAY_VNC_PORT_BASE=5900

# --- Web portal / remote view -------------------------------------------
FRIDAY_BIND_HOST=127.0.0.1
FRIDAY_PORT=8765
# Base URL used in handoff links (e.g. your Tailscale/WireGuard address).
FRIDAY_PUBLIC_BASE_URL=http://127.0.0.1:8765
# argon2 hash of the portal password. Generate with: friday hash-password
# FRIDAY_ADMIN_PASSWORD_HASH=
# Set true when served over HTTPS.
FRIDAY_COOKIE_SECURE=false
FRIDAY_SESSION_TTL_SECONDS=43200
FRIDAY_HANDOFF_TTL_SECONDS=900
